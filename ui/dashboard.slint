// Mikrotik Dashboard: the shell. Chrome at the top and bottom, the card grid in
// between, and one wiring line per value a card draws.
//
//   Traffic             spans the top, two thirds of the width
//   Bandwidth           top right
//   Connections         left column, first
//   Latency             left column, last
//   System              middle, first
//   Interfaces          middle, second
//   Virtual Interfaces  middle, last (vlan/bridge/pppoe)
//   Top Talkers         right column
//
// Interface rows follow `/interface print` — same order, same flags — and split into
// two cards: the real interfaces (ethers, loopback) and the virtual ones (VLANs,
// bridges, PPPoE). Lists flick only when they overflow.
//
// Every value is an `in` property the Rust poller sets; nothing here reads the router,
// so the layout can be rendered from a fixture without a connection.
import { Theme } from "theme.slint";
import { IfaceCard } from "components/iface-card.slint";
import { TableRow } from "components/table.slint";
import { HeaderBar } from "layout/header.slint";
import { StatusLine } from "layout/status-line.slint";
import { TrafficCard } from "cards/traffic.slint";
import { BandwidthCard } from "cards/bandwidth.slint";
import { ConnectionsCard } from "cards/connections.slint";
import { LatencyCard } from "cards/latency.slint";
import { SystemCard } from "cards/system.slint";
import { TalkersCard } from "cards/talkers.slint";

export component DashboardWindow inherits Window {
    title: "Mikrotik Dashboard";
    width: 1920px;
    height: 1080px;
    background: Theme.bg;

    // ── header ────────────────────────────────────────────────────────────────
in property <string> identity: "—";
    in property <string> router-addr: "";
    in property <string> board: "";
    in property <string> ros-version: "";
    in property <string> clock: "";
    in property <string> link-state: "connecting";
    in property <color> link-tint: Theme.warning;

    // ── traffic ───────────────────────────────────────────────────────────────
in property <string> wan-name: "—";
/// The interface the Traffic chart and the Bandwidth gauges follow: `--interface`, or
/// the detected uplink.
in property <string> traffic-iface: "—";
    in property <string> rx-now: "0";
    in property <string> tx-now: "0";
    in property <string> rx-peak: "0";
    in property <string> tx-peak: "0";
    in property <string> traffic-window: "60s";
    in property <string> rx-area: "";
    in property <string> rx-line: "";
    in property <string> tx-area: "";
    in property <string> tx-line: "";

    // ── bandwidth ─────────────────────────────────────────────────────────────
in property <float> dl-pct: 0;
    in property <float> ul-pct: 0;
    in property <string> dl-text: "0";
    in property <string> ul-text: "0";

    /// The three columns of the dashboard grid are equal by construction.
///
/// Leaving it to the layout lets content decide: the tables in Top Talkers and
/// WireGuard have wide preferred widths, so they won 892px while System,
/// Network and Latency were squeezed into 300px. Pinning all three to the same
/// width is the only way they stay equal as the data changes.
private property <length> column-width: (self.width - 32px - 24px) / 3;

    // Every list is flickable, but ONLY when it overflows: a list that fits takes its
// own height and reserves no room for a scrollbar. Rows are 18px with a 6px
// gutter (24n - 6); Connections gives each list 194px of its 538px card.
private property <length> src-content: Math.max(0px, self.top-src.length * 24px - 6px);
    private property <length> dst-content: Math.max(0px, self.top-dst.length * 24px - 6px);
    private property <length> src-height: Math.min(self.src-content, 194px);
    private property <length> dst-height: Math.min(self.dst-content, 194px);

    // ── connections ───────────────────────────────────────────────────────────
in property <int> conn-total: 0;
    in property <float> conn-tcp: 1;
    in property <float> conn-udp: 1;
    in property <float> conn-icmp: 1;
    in property <float> conn-other: 1;
    in property <string> conn-tcp-text: "0";
    in property <string> conn-udp-text: "0";
    in property <string> conn-icmp-text: "0";
    in property <string> conn-other-text: "0";
    in property <[TableRow]> top-src: [];
    in property <[TableRow]> top-dst: [];

    // ── system ────────────────────────────────────────────────────────────────
in property <string> cpu-arc: "";
    in property <string> ram-arc: "";
    in property <string> disk-arc: "";
    in property <string> cpu-text: "0%";
    in property <string> ram-text: "0%";
    in property <string> disk-text: "0%";
    in property <string> sys-line1: "";
    in property <string> sys-line2: "";
    in property <string> sys-line3: "";

    // ── network ───────────────────────────────────────────────────────────────
in property <string> uptime: "";
    in property <[TableRow]> ifaces: [];
    in property <[TableRow]> virtual-ifaces: [];

    // ── latency ───────────────────────────────────────────────────────────────
in property <string> ping-now: "—";
    in property <string> ping-min: "—";
    in property <string> ping-avg: "—";
    in property <string> ping-max: "—";
    in property <string> ping-loss: "—";
    in property <string> ping-target: "—";
    in property <string> ping-path: "";

    // ── talkers ───────────────────────────────────────────────────────────────
in property <[TableRow]> talkers: [];

    // ── footer ────────────────────────────────────────────────────────────────
in property <string> status: "";

    VerticalLayout {
        padding: Theme.pad-frame;
        spacing: Theme.gap-lg;

        HeaderBar {
            identity: root.identity;
            board: root.board;
            router-addr: root.router-addr;
            ros-version: root.ros-version;
            uptime: root.uptime;
            clock: root.clock;
            link-state: root.link-state;
            link-tint: root.link-tint;
        }

        // ── traffic + bandwidth ───────────────────────────────────────────────
HorizontalLayout {
            height: 272px;
            spacing: Theme.gap-lg;

            TrafficCard {
                iface-name: root.traffic-iface;
                rx-now: root.rx-now;
                tx-now: root.tx-now;
                rx-peak: root.rx-peak;
                tx-peak: root.tx-peak;
                traffic-window: root.traffic-window;
                rx-area: root.rx-area;
                rx-line: root.rx-line;
                tx-line: root.tx-line;
                horizontal-stretch: 7;
                min-width: 0;
            }

            BandwidthCard {
                dl-pct: root.dl-pct;
                ul-pct: root.ul-pct;
                dl-text: root.dl-text;
                ul-text: root.ul-text;
                horizontal-stretch: 2;
                min-width: 0;
                max-width: 360px;
            }
        }

        // ── three columns ─────────────────────────────────────────────────────
HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.gap-lg;

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: root.column-width;
                max-width: root.column-width;
                spacing: Theme.gap-lg;

                ConnectionsCard {
                    src-content: root.src-content;
                    dst-content: root.dst-content;
                    src-height: root.src-height;
                    dst-height: root.dst-height;
                    conn-total: root.conn-total;
                    conn-tcp: root.conn-tcp;
                    conn-udp: root.conn-udp;
                    conn-icmp: root.conn-icmp;
                    conn-other: root.conn-other;
                    conn-tcp-text: root.conn-tcp-text;
                    conn-udp-text: root.conn-udp-text;
                    conn-icmp-text: root.conn-icmp-text;
                    conn-other-text: root.conn-other-text;
                    top-src: root.top-src;
                    top-dst: root.top-dst;
                    height: 538px;
                }

                LatencyCard {
                    ping-now: root.ping-now;
                    ping-min: root.ping-min;
                    ping-avg: root.ping-avg;
                    ping-max: root.ping-max;
                    ping-loss: root.ping-loss;
                    ping-target: root.ping-target;
                    ping-path: root.ping-path;
                    height: 120px;
                    min-width: 0;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: root.column-width;
                max-width: root.column-width;
                spacing: Theme.gap-lg;

                SystemCard {
                    cpu-arc: root.cpu-arc;
                    ram-arc: root.ram-arc;
                    disk-arc: root.disk-arc;
                    cpu-text: root.cpu-text;
                    ram-text: root.ram-text;
                    disk-text: root.disk-text;
                    sys-line1: root.sys-line1;
                    sys-line2: root.sys-line2;
                    sys-line3: root.sys-line3;
                    height: 226px;
                    min-width: 0;
                }

                // Real interfaces only: the ethers and the loopback. VLANs, bridges
        // and PPPoE get their own card below.
        IfaceCard {
                    heading: "INTERFACES";
                    rows: root.ifaces;
                    height: 210px;
                    min-width: 0;
                }

                IfaceCard {
                    heading: "VIRTUAL INTERFACES";
                    rows: root.virtual-ifaces;
                    height: 210px;
                    min-width: 0;
                }
            }

            TalkersCard {
                talkers: root.talkers;
                horizontal-stretch: 1;
                min-width: root.column-width;
                max-width: root.column-width;
            }
        }

        StatusLine {
            message: root.status;
        }
    }
}
