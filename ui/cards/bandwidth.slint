import { Card } from "../components/card.slint";
import { Theme } from "../theme.slint";

export component BandwidthCard inherits Card {
    in property <float> dl-pct: 0;
    in property <float> ul-pct: 0;
    in property <string> dl-text: "0";
    in property <string> ul-text: "0";
    heading: "BANDWIDTH";
// Two vertical bars do not earn a wide card: pin the width so the
// Traffic chart takes the rest (the window is a fixed 1920x1080).
// min-width 0 keeps the card's own numbers out of the row's maths.
preferred-width: 360px;

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 18px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.gap-sm;
            Text {
                text: root.dl-text;
                color: Theme.accent;
                font-size: Theme.fs-lg;
                font-weight: 700;
                horizontal-alignment: center;
                height: 20px;
            // Pinned: a wider reading must not re-share the row.
            preferred-width: 160px;
                min-width: 0px;
                overflow: elide;
            }

            HorizontalLayout {
                vertical-stretch: 1;
                Rectangle {
                    horizontal-stretch: 1;
                }

                Rectangle {
                // Fixed width: inside a layout `width` would be
                // ignored and the bar would span the whole column.
                min-width: 72px;
                    preferred-width: 72px;
                    max-width: 72px;
                    vertical-stretch: 1;
                    background: Theme.track;
                    border-radius: Theme.radius-lg;
                    border-width: 1px;
                    border-color: Theme.border;
                // Quarter marks, so the empty height is a scale and
                // not just void.
                for mark in [25, 50, 75]: Rectangle {
                        x: 2px;
                        width: parent.width - 4px;
                        y: (parent.height - 4px) * (1 - mark / 100) + 2px;
                        height: 1px;
                        background: Theme.raised;
                    }
                    Rectangle {
                        x: 2px;
                        width: parent.width - 4px;
                        y: parent.height - self.height;
                    // A floor keeps a 1% reading a visible sliver.
                    height: max((parent.height - 4px) * (root.dl-pct / 100), 3px);
                        background: Theme.accent;
                        border-radius: Theme.radius-md;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            Text {
                text: "DOWNLOAD";
                color: Theme.text-subtle;
                font-size: Theme.fs-2xs;
                font-weight: 700;
                letter-spacing: 1.2px;
                horizontal-alignment: center;
                height: 14px;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.gap-sm;
            Text {
                text: root.ul-text;
                color: Theme.success;
                font-size: Theme.fs-lg;
                font-weight: 700;
                horizontal-alignment: center;
                height: 20px;
            // Pinned: a wider reading must not re-share the row.
            preferred-width: 160px;
                min-width: 0px;
                overflow: elide;
            }

            HorizontalLayout {
                vertical-stretch: 1;
                Rectangle {
                    horizontal-stretch: 1;
                }

                Rectangle {
                // Fixed width: inside a layout `width` would be
                // ignored and the bar would span the whole column.
                min-width: 72px;
                    preferred-width: 72px;
                    max-width: 72px;
                    vertical-stretch: 1;
                    background: Theme.track;
                    border-radius: Theme.radius-lg;
                    border-width: 1px;
                    border-color: Theme.border;
                // Quarter marks, so the empty height is a scale and
                // not just void.
                for mark in [25, 50, 75]: Rectangle {
                        x: 2px;
                        width: parent.width - 4px;
                        y: (parent.height - 4px) * (1 - mark / 100) + 2px;
                        height: 1px;
                        background: Theme.raised;
                    }
                    Rectangle {
                        x: 2px;
                        width: parent.width - 4px;
                        y: parent.height - self.height;
                    // A floor keeps a 1% reading a visible sliver.
                    height: max((parent.height - 4px) * (root.ul-pct / 100), 3px);
                        background: Theme.success;
                        border-radius: Theme.radius-md;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            Text {
                text: "UPLOAD";
                color: Theme.text-subtle;
                font-size: Theme.fs-2xs;
                font-weight: 700;
                letter-spacing: 1.2px;
                horizontal-alignment: center;
                height: 14px;
            }
        }
    }
}
